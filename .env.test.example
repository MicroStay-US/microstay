# Copy this to .env.local and fill in real values before running tests

# Base URL of the running dev server
TEST_BASE_URL=http://localhost:3001

# Admin credentials (must be in ADMIN_EMAILS list in lib/auth.ts)
TEST_ADMIN_EMAIL=admin@microstay.us
TEST_ADMIN_PASSWORD=your_admin_password_here

# A real vendor account for vendor flow tests
TEST_VENDOR_EMAIL=vendor@example.com
TEST_VENDOR_PASSWORD=your_vendor_password_here
