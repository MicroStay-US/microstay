# Copy this to .env.test.local and fill in real values before running E2E tests.
# NEVER commit .env.test.local — it is gitignored.
# In CI (GitHub Actions / Vercel), set these as repository secrets.

# Base URL of the running dev/staging server
TEST_BASE_URL=http://localhost:3001

# Admin credentials — single shared admin account.
# Set NEXT_PUBLIC_ADMIN_EMAIL in your production .env.local too.
TEST_ADMIN_EMAIL=adminmotel@gmail.com
TEST_ADMIN_PASSWORD=your_admin_password_here

# Admin email also used in the production app (admin/login/page.tsx)
NEXT_PUBLIC_ADMIN_EMAIL=adminmotel@gmail.com

# A real vendor test account for vendor portal flow tests.
# Use a dedicated test account, NOT a production vendor account.
TEST_VENDOR_EMAIL=your_test_vendor@example.com
TEST_VENDOR_PASSWORD=your_test_vendor_password_here

# Google reCAPTCHA v3 Config (optional for tests, will bypass if empty)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Le6aoYtAAAAAIzMap-ItABx1ziFjmVHrtN0DAh4
RECAPTCHA_SECRET_KEY=6Le6aoYtAAAAAODXjSAVSNobjWZ31RU5X4FVE2Uf
RECAPTCHA_MIN_SCORE=0.5
